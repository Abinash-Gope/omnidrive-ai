# ==============================================================================
# OmniDrive AI - Root Workspace Git Ignore
# Note: Specific component rules are isolated in:
#   - frontend/.gitignore
#   - backend/.gitignore
# ==============================================================================

# OS Metadata & System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE & Editor Configurations
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Temporary & Log Files
*.log
logs/
.tmp/
temp/
